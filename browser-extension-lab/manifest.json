{
  "manifest_version": 3,
  "name": "拾隅 · 双模式试用版",
  "version": "1.0.9",
  "description": "一键收下当前网页，稍后整理，或归入拾隅的空间、场景和分组。",
  "minimum_chrome_version": "116",
  "commands": {
    "_execute_action": {}
  },
  "permissions": [
    "activeTab",
    "storage",
    "scripting",
    "sidePanel"
  ],
  "host_permissions": [
    "https://shiyubox.com/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "收藏到拾隅",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none'"
  },
  "side_panel": {
    "default_path": "panel.html"
  }
}
